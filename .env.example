# .env file — iska copy banake .env naam se save karein aur values fill karein
# Jab Telegram bot backend use karna ho:
DOWNLOAD_BACKEND=telegram

# 1. https://my.telegram.org  ->  API Development tools  ->  naya app banayein
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# 2. Session string generate karne ke liye:  python generate_session.py
TELEGRAM_SESSION_STRING=paste_session_string_here

# 3. Kaunsa bot use karna hai?
BOT_USERNAME=allsaverbot
